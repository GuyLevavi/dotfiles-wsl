# Dockerfile.airgap — Full airgap-ready image with everything baked in.
#
# This Dockerfile expects you to COPY a pre-built bundle tarball into the image.
# The bundle should contain: CLI tools, system packages, zsh plugins, nvim plugins.
#
# Build:
#   # First, build the bundle on an online machine:
#   bash airgap/bundle.sh
#
#   # Then build the Docker image (from the same machine with the bundle):
#   docker build -f Dockerfile.airgap \
#     --build-arg BUNDLE=../airgap/devenv-bundle-20260224.tar.gz \
#     -t myimage:tag .
#
# Or build without bundle (will have configs but no tools/plugins):
#   docker build -f Dockerfile.airgap -t myimage:tag .
ARG BASE_IMAGE=registry.fedoraproject.org/fedora:43
ARG BUNDLE=
FROM ${BASE_IMAGE}

# Use bash for all RUN commands
SHELL ["/bin/bash", "-c"]

# ── System packages (same as base Dockerfile) ────────────────────────────────
RUN source /etc/os-release && \
    case "${ID:-}" in \
      fedora|rhel|centos|almalinux|rocky) \
        if [ "${ID}" != "fedora" ]; then \
          VER="${VERSION_ID%%.*}" && \
          dnf install -y \
            "https://dl.fedoraproject.org/pub/epel/epel-release-latest-${VER}.noarch.rpm" \
          || dnf install -y epel-release || true && \
          /usr/bin/crb enable 2>&1 || true && \
          dnf makecache --quiet; \
        fi && \
        dnf install -y --allowerasing \
          curl wget unzip tar gzip bzip2 xz which file gawk \
          zsh stow git git-lfs \
          podman buildah skopeo fuse-overlayfs \
          python3-devel python3-pip \
          jq && \
        dnf install -y procps-ng htop tree tmux nodejs npm ShellCheck \
          2>/dev/null || \
        dnf install -y procps-ng htop nodejs npm \
          2>/dev/null || true && \
        dnf clean all && \
        rm -rf /var/cache/dnf \
        ;; \
      ubuntu|debian) \
        export DEBIAN_FRONTEND=noninteractive && \
        apt-get update && \
        apt-get install -y --no-install-recommends \
          curl wget unzip tar gzip bzip2 xz-utils file tree htop procps \
          zsh tmux stow git git-lfs gawk \
          nodejs npm \
          python3-dev python3-pip \
          jq shellcheck fuse-overlayfs \
        && apt-get clean && rm -rf /var/lib/apt/lists/* \
        ;; \
      *) echo "Unsupported distro: ${ID:-unknown}" >&2; exit 1 ;; \
    esac

# ── Create dev user ─────────────────────────────────────────────────────────
RUN source /etc/os-release && \
    case "${ID:-}" in \
      ubuntu|debian) SUDO_GROUP=sudo ;; \
      *)             SUDO_GROUP=wheel ;; \
    esac && \
    command -v sudo >/dev/null 2>&1 || { \
      dnf install -y sudo 2>/dev/null || apt-get install -y sudo 2>/dev/null || true; \
    } && \
    mkdir -p /etc/sudoers.d && \
    getent group wheel >/dev/null 2>&1 || groupadd wheel && \
    ZSH_PATH="$(command -v zsh 2>/dev/null || echo /usr/bin/zsh)" && \
    useradd --create-home --shell "$ZSH_PATH" gl && \
    usermod --append --groups "$SUDO_GROUP" gl && \
    echo "%${SUDO_GROUP} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/sudo-nopasswd && \
    chmod 0440 /etc/sudoers.d/sudo-nopasswd

# ── XDG directories ─────────────────────────────────────────────────────────
USER gl
WORKDIR /home/gl
RUN mkdir -p .local/bin .local/share .local/state .config .cache

# ── Clone repo and stow dotfiles ────────────────────────────────────────────
USER root
RUN dnf install -y stow 2>/dev/null || apt-get install -y stow 2>/dev/null || true
USER gl
RUN git clone --depth 1 https://github.com/GuyLevavi/dotfiles-wsl.git /tmp/dotfiles \
    && cd /tmp/dotfiles \
    && for pkg in zsh starship nvim tmux yazi git podman opencode codex; do \
         stow -v -t ~ "$pkg" 2>/dev/null || true; \
       done \
    && rm -rf /tmp/dotfiles

# ── If bundle provided, install tools + plugins via deploy.sh ─────────────────
# This is what makes the image truly "airgap ready" - everything from bundle.
# The bundle should have been built on an online machine with:
#   bash airgap/bundle.sh
# Then copy the tarball into the build context.
#
# NOTE: For CI/CD, the bundle is a release asset. Users can download it and
# build their own image with the bundle baked in:
#   docker build -f Dockerfile.airgap --build-arg BUNDLE=./devenv-bundle.tar.gz .
#
# For now, we skip the bundle in CI to get a working release. The image will
# have dotfiles but not the CLI tools/plugins - those come from the bundle.
RUN echo "NOTE: Bundle not included in CI build. Build with --build-arg BUNDLE to include."

# Note: nvim verification happens in CI tests, not here, because:
# - We need to test with the actual bundle, not just the Dockerfile build
# - The release workflow already tests this

# ── Default shell ─────────────────────────────────────────────────────────
ENV SHELL=/usr/bin/zsh
CMD ["/usr/bin/zsh"]
